# Backlog — Apache config for cPanel / shared hosting.
# Drops into the same folder as index.html and the api/ directory.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pretty API URLs: /api/check-status -> /api/check-status.php
  RewriteRule ^api/check-status/?$  api/check-status.php  [L]
  RewriteRule ^api/healthcheck/?$   api/healthcheck.php   [L]

  # Let real files and directories (assets, PHP files) serve normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback: every other URL renders index.html so React Router takes over.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache hashed assets, no-cache index.html.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
